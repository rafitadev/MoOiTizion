<UserControl x:Class="WindowsPerformanceOptimizer.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="System Overview" FontSize="28" FontWeight="Bold"/>
        <UniformGrid Grid.Row="1" Margin="0,20,0,0" Columns="3">
            <Border Margin="6" Padding="18" Background="#F3F4F6"><StackPanel><TextBlock Text="CPU"/><TextBlock Text="{Binding Cpu, StringFormat={}{0:F0}%}" FontSize="28"/></StackPanel></Border>
            <Border Margin="6" Padding="18" Background="#F3F4F6"><StackPanel><TextBlock Text="RAM"/><TextBlock Text="{Binding Ram, StringFormat={}{0:F0}%}" FontSize="28"/></StackPanel></Border>
            <Border Margin="6" Padding="18" Background="#F3F4F6"><StackPanel><TextBlock Text="Disk"/><TextBlock Text="{Binding Disk, StringFormat={}{0:F0}%}" FontSize="28"/></StackPanel></Border>
            <Border Margin="6" Padding="18" Background="#F3F4F6"><StackPanel><TextBlock Text="GPU"/><TextBlock Text="{Binding Gpu, StringFormat={}{0:F0}%}" FontSize="28"/></StackPanel></Border>
            <Border Margin="6" Padding="18" Background="#F3F4F6"><StackPanel><TextBlock Text="Temperature"/><TextBlock Text="{Binding Temp, StringFormat={}{0:F0}°C}" FontSize="28"/></StackPanel></Border>
        </UniformGrid>
    </Grid>
</UserControl>
