<UserControl x:Class="WindowsPerformanceOptimizer.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Performance Profiles" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"/>
        <GroupBox Header="Tweaks planned" Grid.Row="2" Margin="0,12,0,0"><ListBox ItemsSource="{Binding Tweaks}" DisplayMemberPath="Name"/></GroupBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Apply with Backup" Command="{Binding ApplySelectedCommand}" Width="150" Margin="0,0,12,0"/>
            <Button Content="Restore Defaults" Command="{Binding RestoreDefaultsCommand}" Width="150"/>
            <TextBlock Text="{Binding Status}" Margin="16,8,0,0" TextWrapping="Wrap" Width="520"/>
        </StackPanel>
    </Grid>
</UserControl>
